class ServiceOverloading {

    // Method with two integers
    int add(int a, int b) {
        return a + b;
    }

    // Method with three integers
    int add(int a, int b, int c) {
        return a + b + c;
    }

    // Method with two double values
    double add(double a, double b) {
        return a + b;
    }

    public static void main(String[] args) {
        ServiceOverloading obj = new ServiceOverloading();

        System.out.println("Sum (2 ints): " + obj.add(5, 10));
        System.out.println("Sum (3 ints): " + obj.add(5, 10, 15));
        System.out.println("Sum (2 doubles): " + obj.add(5.5, 4.5));
    }
}
