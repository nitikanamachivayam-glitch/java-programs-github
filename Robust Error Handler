import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        try {
            System.out.print("Enter numerator: ");
            int num = sc.nextInt();

            System.out.print("Enter denominator: ");
            int den = sc.nextInt();

            int result = num / den; // Can throw ArithmeticException
            System.out.println("Result: " + result);

            System.out.print("Enter an array index to access: ");
            int index = sc.nextInt();

            int[] arr = {10, 20, 30};
            System.out.println("Array value: " + arr[index]); // Can throw ArrayIndexOutOfBoundsException

        } catch (ArithmeticException e) {
            System.out.println("Error: Division by zero is not allowed.");
        } catch (ArrayIndexOutOfBoundsException e) {
            System.out.println("Error: Invalid array index.");
        } catch (Exception e) {
            System.out.println("Error: Invalid input or unexpected error.");
        } finally {
            System.out.println("Program execution completed.");
            sc.close();
        }
    }
}
