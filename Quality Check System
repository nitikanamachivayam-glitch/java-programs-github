import java.util.Scanner;

public class QualityCheckSystem {

    // Method to check prime
    public static boolean isPrime(int number) {

        if (number <= 1) {
            return false;
        }

        for (int i = 2; i <= Math.sqrt(number); i++) {
            if (number % i == 0) {
                return false;
            }
        }

        return true;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a number for Quality Check: ");
        int num = sc.nextInt();

        if (isPrime(num)) {
            System.out.println(num + " PASSED Quality Check (Prime Number)");
        } else {
            System.out.println(num + " FAILED Quality Check (Not a Prime Number)");
        }

        sc.close();
    }
}
